{
  "version": 1,
  "_doc": "Registry of every asset module. Paths are relative to the assets/ folder. type 'module' = JS file exporting meta + build(THREE, opts); type 'glb' = binary model scaled to fit the lot. kinds match parser.js buildingKind()/roadKind(). areaRange (m2) and heightRange (m) steer automatic matching in Build City.",
  "buildings": [
    {
      "id": "house_small",
      "name": "Small House",
      "category": "residential",
      "type": "module",
      "path": "buildings/residential/house_small.js",
      "kinds": [
        "house",
        "generic"
      ],
      "areaRange": [
        15,
        220
      ],
      "heightRange": [
        2.5,
        10
      ]
    },
    {
      "id": "apartment_block",
      "name": "Apartment Block",
      "category": "residential",
      "type": "module",
      "path": "buildings/residential/apartment_block.js",
      "kinds": [
        "apartment",
        "house",
        "generic"
      ],
      "areaRange": [
        80,
        2500
      ],
      "heightRange": [
        9,
        45
      ]
    },
    {
      "id": "shop_row",
      "name": "Shop Row",
      "category": "commercial",
      "type": "module",
      "path": "buildings/commercial/shop_row.js",
      "kinds": [
        "commercial",
        "generic"
      ],
      "areaRange": [
        30,
        900
      ],
      "heightRange": [
        3,
        16
      ]
    },
    {
