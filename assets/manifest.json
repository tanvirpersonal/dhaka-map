        "office",
        "commercial"
      ],
      "areaRange": [
        120,
        5000
      ],
      "heightRange": [
        18,
        220
      ]
    },
    {
      "id": "warehouse",
      "name": "Warehouse",
      "category": "industrial",
      "type": "module",
      "path": "buildings/industrial/warehouse.js",
      "kinds": [
        "industrial",
        "generic"
      ],
      "areaRange": [
        80,
        8000
      ],
      "heightRange": [
        3.5,
        16
      ]
    },
    {
      "id": "school",
      "name": "School / Public Building",
      "category": "public",
      "type": "module",
      "path": "buildings/public/school.js",
      "kinds": [
        "public"
      ],
      "areaRange": [
        150,
