  "streets": [
    {
      "id": "asphalt_primary",
      "name": "Primary Road",
      "type": "module",
      "path": "streets/asphalt_primary.js",
      "kinds": [
        "primary"
      ],
      "tileLength": 12,
      "enabled": false
    },
    {
      "id": "asphalt_secondary",
      "name": "Secondary Road",
      "type": "module",
      "path": "streets/asphalt_secondary.js",
      "kinds": [
        "secondary"
      ],
      "tileLength": 10,
      "enabled": false
    },
    {
      "id": "residential_lane",
      "name": "Residential Lane",
      "type": "module",
      "path": "streets/residential_lane.js",
